{
  "name": "master-trade",
  "version": "0.6.0",
  "description": "Master Trade — Trading Training Agent: Model + typed deterministic Tools + versioned Instructions. Training-only, no live trading.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:web": "vite --port 5173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "api": "node dist/src/server/start.js",
    "db:migrate": "node dist/src/db/cli.js migrate",
    "db:status": "node dist/src/db/cli.js status",
    "db:ownership": "node dist/src/db/cli.js ownership",
    "db:schema": "node dist/src/db/cli.js schema",
    "preview:web": "vite preview --port 4173 --strictPort",
    "validate": "npm run format:check && npm run typecheck && npm run typecheck:web && npm run test && npm run build && npm run build:web && npm run desktop:verify",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "agent:demo": "node dist/src/agent/demo.js",
    "ai:demo": "node dist/src/agent/aiDemo.js",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "desktop:verify": "node dist/src/desktop/cli.js",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "fastify": "^5.2.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.469.0",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  }
}
