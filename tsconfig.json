{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@shared/api/contracts": ["./packages/shared/src/api/contracts.js"],
      "@shared/core/errors": ["./packages/shared/src/core/errors.js"],
      "@shared/core/headers": ["./packages/shared/src/core/headers.js"],
      "@shared/core/ids": ["./packages/shared/src/core/ids.js"],
      "@shared/core/provenance": ["./packages/shared/src/core/provenance.js"],
      "@shared/desktop/ipc": ["./packages/shared/src/desktop/ipc.js"],
      "@shared/frontend/viewModels": ["./packages/shared/src/frontend/viewModels.js"],
      "@shared/jobs/service": ["./packages/shared/src/jobs/service.js"],
      "@shared/marketdata/provider": ["./packages/shared/src/marketdata/provider.js"],
      "@shared/profile/model": ["./packages/shared/src/profile/model.js"],
      "@shared/realtime/contracts": ["./packages/shared/src/realtime/contracts.js"],
      "@shared/realtime/events": ["./packages/shared/src/realtime/events.js"],
      "@shared/realtime/protocol": ["./packages/shared/src/realtime/protocol.js"],
      "@shared/types": ["./packages/shared/src/types.js"]
    }
  },
  "include": [
    "packages/trading-engine/src/**/*.ts",
    "packages/shared/src/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "web/src/config/**/*.ts",
    "web/src/design/**/*.ts",
    "web/src/mock/**/*.ts"
  ]
}
