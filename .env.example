# Master Trade — environment variables (example file; never commit real keys)
#
# Copy to `.env` and fill in what you need. Everything here is optional: with
# no variables at all the app runs fully offline on the deterministic scripted
# adapter (`MASTER_TRADE_AI_PROVIDER=scripted` is the default), and local
# development needs none of the keys below.
#
# Every variable is read server-side only (src/config/loader.ts). The browser
# bundle never receives, requests or stores any of these values, and the API
# binds loopback only, so a key configured here never leaves the machine except
# in requests to the provider it authenticates against.
#
# Secrets are referenced, never inlined: MASTER_TRADE_AI_KEY_ENV names the
# environment variable that holds the credential (a `SecretRef`), so the config
# object itself can be logged without leaking it.

# ── AI provider ─────────────────────────────────────────────────────────────
# One of: scripted | openai | anthropic | arvancloud | local-openai-compatible
#MASTER_TRADE_AI_PROVIDER=arvancloud

# Model id exactly as the provider names it.
#MASTER_TRADE_AI_MODEL=DeepSeek-V4-Flash

# Monthly spend ceiling in USD; the gateway refuses calls beyond it.
#MASTER_TRADE_AI_MONTHLY_BUDGET_USD=25

# The NAME of the environment variable that holds the provider credential.
# For ArvanCloud, set MASTER_TRADE_AI_KEY_ENV=ARVANCLOUD_API_KEY and put the
# key itself on the line below. ArvanCloud AI (api.arvancloudai.ir,
# /chat/completions, model DeepSeek-V4-Flash) authenticates with
# `Authorization: apikey <key>` — the scheme is handled by the adapter.
#MASTER_TRADE_AI_KEY_ENV=ARVANCLOUD_API_KEY
#ARVANCLOUD_API_KEY=replace-with-your-arvancloud-key

# Local OpenAI-compatible server (Ollama, llama.cpp, LM Studio…) needs no key:
#MASTER_TRADE_AI_PROVIDER=local-openai-compatible
#MASTER_TRADE_AI_MODEL=local-model

# ── API server ──────────────────────────────────────────────────────────────
# Loopback-only by design; non-loopback hosts are refused at start-up.
#MASTER_TRADE_API_HOST=127.0.0.1
#MASTER_TRADE_API_PORT=4317
#MASTER_TRADE_LOG_LEVEL=info
